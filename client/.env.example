# Stream Chat API key (public key, safe for the client bundle)
VITE_STREAM_API_KEY=your_stream_api_key_here

# Deployed backend origin, no trailing slash (e.g. https://insell-api.onrender.com).
# Leave unset for local dev — vite.config.js proxies /api to localhost:5001 instead.
VITE_API_URL=

# PostHog project API key (public, safe for the client bundle). Leave unset
# to disable analytics entirely — the app no-ops without it.
VITE_POSTHOG_KEY=
# PostHog ingestion host. Defaults to https://us.i.posthog.com if unset;
# only override for EU/self-hosted PostHog instances.
VITE_POSTHOG_HOST=
