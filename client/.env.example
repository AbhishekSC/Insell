# Stream Chat API key (public key, safe for the client bundle)
VITE_STREAM_API_KEY=your_stream_api_key_here

# Deployed backend origin, no trailing slash (e.g. https://insell-api.onrender.com).
# Leave unset for local dev — vite.config.js proxies /api to localhost:5001 instead.
VITE_API_URL=

# PostHog project API key (public, safe for the client bundle). Leave unset
# to disable analytics entirely — the app no-ops without it.
VITE_POSTHOG_KEY=
# PostHog ingestion host. Defaults to https://us.i.posthog.com if unset;
# only override for EU/self-hosted PostHog instances.
VITE_POSTHOG_HOST=

# Sentry error tracking DSN (public, safe for the client bundle). Leave
# unset to disable — the app no-ops without it. Get a free DSN at
# https://sentry.io/
VITE_SENTRY_DSN=

# Firebase web app config (all public, safe for the client bundle) — from
# Firebase Console > Project Settings > General > your web app. Leave any
# of these unset to disable push notifications entirely; the "Enable
# notifications" menu item just doesn't render.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Web Push certificate key from Project Settings > Cloud Messaging > Web
# configuration > "Generate key pair".
VITE_FIREBASE_VAPID_KEY=
